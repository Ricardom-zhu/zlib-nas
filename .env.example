# Copy to .env and adjust. Everything here is optional: you can also set the
# mirror domain and sign in from the web UI after the container starts.

# pip index used when building the image. Change it if pypi.org is slow
# where you are, e.g. https://mirrors.aliyun.com/pypi/simple
PIP_INDEX_URL=https://pypi.org/simple

# Z-Library mirror domain, without https://
ZLIB_DOMAIN=

# Optional auto-login. The password is used once and never written to disk;
# only the resulting session cookie is persisted under data/.
ZLIB_EMAIL=
ZLIB_PASSWORD=

# Optional HTTP proxy, used for both the mirror and the download CDN.
# PROXY=http://192.168.1.10:7890

# Optional: also expose finished files in this folder via symlinks, so another
# tool (e.g. a book manager that scans a directory) can pick them up.
# MIRROR_DIR=/books/incoming

# Pause the queue when this many downloads remain in the daily allowance.
QUOTA_RESERVE=0

# How many books to download at once. Keep at 1: the quota is the bottleneck.
MAX_CONCURRENT=1
